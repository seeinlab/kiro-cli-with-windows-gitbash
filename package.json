{
  "name": "win-gitbash-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing execute_bash via Git Bash on Windows",
  "type": "module",
  "bin": {
    "win-gitbash-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "bundle": "node node_modules/esbuild/bin/esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js",
    "dev": "node node_modules/typescript/bin/tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  }
}
